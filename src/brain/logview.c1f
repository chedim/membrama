PACK membrama_logview 1
IMPORT dom 1
IMPORT fetch 1
IMPORT shell_view 1
-- THE LOG TAB (written to the seat by membrama when it connects, `Pack:membrama_logview.text`; the seat places it on the page because it imports `dom`). A tab in the shell (`Nav:membrama_log`, the view-pack
-- contract of docs/ui-rebuild-plan.md) that shows the LATEST lines of the seat's boundary log, one per change: `n eid.prop op by writer`, and follows new ones while the tab is the one in front.
-- The page cannot read the view by its link (`membrane::LogView:<ns>` is virtual and a link does not carry a virtual entity's values), so it does what docs/logview.md says a page does, with the door
-- (`POST /mcp`, as link_view.c1f does): it ASKS by writing `<its ns>::LogAsk:main` (`from`, then `n`, a count: the cache breaker) and READS `membrane::LogView:<its ns>` with `entity_read`.
--   on open       one ask (`n` only, from 0), read `head`; then ask from max(0, head - (200 - 1)), so the page shows the last 200 lines
--   on the tick   the shell's own (`Shell.tick`, at the shell's `status_ms`), only while the tab is active: ask from the line after the last one shown (a new `n`), read `rows`, append, keep the last 200
-- 200 is the seat's own page size (packs/logview.c1f). The three calls of an ask are `Fetch:mlog:from`, `Fetch:mlog:n`, `Fetch:mlog:read`, one POST each, chained by their receipts. A call that fails is `MLog:main.note`,
-- shown on the tab. The guard pack removes this tab when membrama's link is not up.
--   MLog:main   `phase` (None, 'head', 'follow'), `step` (from, n, read, headread), `last` (the number of the last line shown), `lines`, `seq`, `polling`, `last_poll`, `note`

Shell.open on-setter membrama-log-register:
  WHEN this.open:
    ('Nav:membrama_log').title = 'Log'
    ('Nav:membrama_log').order = 85

Nav.active on-setter membrama-log-draw:
  WHEN this.eid == 'Nav:membrama_log' and this.active == True:
    ('DomNode:mlog:root').tag = 'pre'
    ('DomNode:mlog:root').parent = 'DomNode:shell:slot:membrama_log'
    ('Nav:membrama_log').filled = True
    ('MLog:main').on = True

MLog.ns getter: prop('Link:page', 'ns')
MLog.text getter: join(this.lines or [], '\n') + (('\n' if this.lines else '') + str(this.note) if this.note else '')
MLog.text on-setter membrama-log-text:
  WHEN this.on == True:
    ('DomNode:mlog:root').text = this.text
MLog.on on-setter membrama-log-first:
  WHEN this.on == True:
    ('DomNode:mlog:root').text = this.text

-- the receipt of a call, read once: ok = the seat answered 2xx and the call has no error; `text` is what the door's tool answered
Fetch.mq getter:
  rq = this.request_result
  bd = json(str(prop(rq, 'body') or ''))
  jd = bd if bd is Dict else {}
  hs = prop(rq, 'http_status')
  cs = prop(prop(jd, 'result'), 'content') or []
  er = prop(jd, 'error')
  {'ok': prop(rq, 'status') == 'ok' and hs != None and hs >= 200 and hs < 300 and not er and not prop(prop(jd, 'result'), 'isError'), 'text': prop(cs[0], 'text') if len(cs) > 0 else None, 'why': (str(prop(er, 'message') if er is Dict else (er or prop(prop(jd, 'result'), 'content'))) if (er or prop(prop(jd, 'result'), 'isError')) else 'the seat answered ' + str(hs)) if prop(rq, 'status') == 'ok' else str(prop(rq, 'head') or 'the request failed')} if rq != None else None

-- an ask starts on the shell's tick, while the tab is in front and none is running; the first one finds the head
Shell.tick on-setter membrama-log-poll:
  WHEN this.open and prop('Nav:membrama_log', 'active') == True and prop('MLog:main', 'ns') != None and not prop('MLog:main', 'polling') and not prop('Conn:page', 'hidden') and this.tick - (prop('MLog:main', 'last_poll') or 0) >= this.status_ms / 1000 and prop('MLog:main', 'phase') == None:
    n = (prop('MLog:main', 'seq') or 0) + 1
    ('MLog:main').seq = n
    ('MLog:main').polling = True
    ('MLog:main').phase = 'head'
    ('MLog:main').step = 'n'
    ('Fetch:mlog:n').request = {'timeout_s': 10, 'id': 'mlog-n-' + str(n), 'url': '/mcp', 'method': 'POST', 'headers': {'content-type': 'application/json'}, 'body': str({'jsonrpc': '2.0', 'id': n, 'method': 'tools/call', 'params': {'name': 'entity_write', 'arguments': {'spec': prop('MLog:main', 'ns') + '::LogAsk:main', 'prop': 'n', 'value': n}}})}
  ELSE WHEN this.open and prop('Nav:membrama_log', 'active') == True and prop('MLog:main', 'ns') != None and not prop('MLog:main', 'polling') and not prop('Conn:page', 'hidden') and this.tick - (prop('MLog:main', 'last_poll') or 0) >= this.status_ms / 1000 and prop('MLog:main', 'phase') == 'follow':
    n = (prop('MLog:main', 'seq') or 0) + 1
    ('MLog:main').seq = n
    ('MLog:main').polling = True
    ('MLog:main').step = 'from'
    ('Fetch:mlog:from').request = {'timeout_s': 10, 'id': 'mlog-from-' + str(n), 'url': '/mcp', 'method': 'POST', 'headers': {'content-type': 'application/json'}, 'body': str({'jsonrpc': '2.0', 'id': n, 'method': 'tools/call', 'params': {'name': 'entity_write', 'arguments': {'spec': prop('MLog:main', 'ns') + '::LogAsk:main', 'prop': 'from', 'value': prop('MLog:main', 'last') + 1}}})}

-- the calls of an ask, one after the other, by their receipts
Fetch.mq on-setter membrama-log-step:
  WHEN startswith(this.eid, 'Fetch:mlog:') and this.mq != None and not prop(this.mq, 'ok'):
    ('MLog:main').note = 'the seat did not answer the log tab (' + this.eid + '): ' + str(prop(this.mq, 'why'))
    ('MLog:main').polling = False
    ('MLog:main').last_poll = clock
  ELSE WHEN this.eid == 'Fetch:mlog:from' and this.mq != None and prop('MLog:main', 'step') == 'from':
    ('MLog:main').step = 'n'
    ('Fetch:mlog:n').request = {'timeout_s': 10, 'id': 'mlog-n-' + str(prop('MLog:main', 'seq')), 'url': '/mcp', 'method': 'POST', 'headers': {'content-type': 'application/json'}, 'body': str({'jsonrpc': '2.0', 'id': prop('MLog:main', 'seq'), 'method': 'tools/call', 'params': {'name': 'entity_write', 'arguments': {'spec': prop('MLog:main', 'ns') + '::LogAsk:main', 'prop': 'n', 'value': prop('MLog:main', 'seq')}}})}
  ELSE WHEN this.eid == 'Fetch:mlog:n' and this.mq != None and prop('MLog:main', 'step') == 'n':
    ('MLog:main').step = 'headread' if prop('MLog:main', 'phase') == 'head' else 'read'
    ('Fetch:mlog:read').request = {'timeout_s': 10, 'id': 'mlog-read-' + str(prop('MLog:main', 'seq')), 'url': '/mcp', 'method': 'POST', 'headers': {'content-type': 'application/json'}, 'body': str({'jsonrpc': '2.0', 'id': prop('MLog:main', 'seq'), 'method': 'tools/call', 'params': {'name': 'entity_read', 'arguments': {'spec': 'membrane::LogView:' + prop('MLog:main', 'ns'), 'prop': 'head' if prop('MLog:main', 'phase') == 'head' else 'rows'}}})}
  ELSE WHEN this.eid == 'Fetch:mlog:read' and this.mq != None and prop('MLog:main', 'step') == 'headread':
    hd = num(str(prop(this.mq, 'text') or ''))
    ('MLog:main').last = (max(0, hd - 199) - 1) if hd is Number else -1
    ('MLog:main').phase = 'follow'
    ('MLog:main').note = None
    ('MLog:main').polling = False
    ('MLog:main').last_poll = 0
  ELSE WHEN this.eid == 'Fetch:mlog:read' and this.mq != None and prop('MLog:main', 'step') == 'read':
    rs = json(str(prop(this.mq, 'text') or ''))
    rw = [r for r in (rs if rs is List else []) if prop(r, 'n') > (prop('MLog:main', 'last') if prop('MLog:main', 'last') != None else -1)]
    ('MLog:main').lines = tail(concat(prop('MLog:main', 'lines') or [], [str(prop(r, 'n')) + ' ' + str(prop(r, 'eid')) + '.' + str(prop(r, 'prop')) + ' ' + str(prop(r, 'op')) + ' by ' + str(prop(r, 'writer')) for r in rw]), 200)
    ('MLog:main').last = max([prop(r, 'n') for r in rw]) if len(rw) > 0 else prop('MLog:main', 'last')
    ('MLog:main').note = None
    ('MLog:main').polling = False
    ('MLog:main').last_poll = clock
