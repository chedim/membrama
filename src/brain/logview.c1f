PACK membrama_logview 1
IMPORT dom 1
IMPORT fetch 1
IMPORT shell_view 1
-- THE LOOP'S SECTION OF THE SEAT'S LOG TAB (written to the seat by membrama when it connects, `Pack:membrama_logview.text`; the seat places it on the page because it imports `dom`). The Log tab is the SEAT's
-- (`Nav:log`, babyseat apps/barest.c1f/log_view.c1f: the boundary log and the raw chat with the model, no peer needed); membrama only ADDS a section to it while it is connected: the loop's own raw chat,
-- `@NS@::Loop:main.chat` (src/brain.rs, `chat_add`), read by the door (`entity_read`, one POST, `Fetch:mloop:read`) on the shell's tick while the tab is in front. The seat's tab owns `Nav:log` and its root
-- `DomNode:log:root`; this pack never writes them: its section is two DomNodes (`DomNode:mloop:head`, `DomNode:mloop:chat`) parented to the root, drawn once the seat's tab has drawn (`Nav:log.filled`), and its own state
-- `MLoop:main` (`text`, `polling`, `last_poll`, `seq`, `note`). A seat with no such tab shows nothing of it.

Nav.filled on-setter membrama-loop-draw:
  WHEN this.eid == 'Nav:log' and this.filled == True:
    ('DomNode:mloop:head').parent = 'DomNode:log:root'
    ('DomNode:mloop:head').tag = 'div'
    ('DomNode:mloop:head').text = 'The loop (@NS@): its own chat with the model (raw: the prompt, the reply with its thinking, each call and its result; the oldest text drops first)'
    ('DomNode:mloop:chat').parent = 'DomNode:log:root'
    ('DomNode:mloop:chat').tag = 'pre'
    ('MLoop:main').on = True

-- the receipt of a call, read once: ok = the seat answered 2xx and the call has no error; `text` is what the door's tool answered
Fetch.ml getter:
  rq = this.request_result
  bd = json(str(prop(rq, 'body') or ''))
  jd = bd if bd is Dict else {}
  hs = prop(rq, 'http_status')
  cs = prop(prop(jd, 'result'), 'content') or []
  er = prop(jd, 'error')
  {'ok': prop(rq, 'status') == 'ok' and hs != None and hs >= 200 and hs < 300 and not er and not prop(prop(jd, 'result'), 'isError'), 'text': prop(cs[0], 'text') if len(cs) > 0 else None, 'why': (str(prop(er, 'message') if er is Dict else (er or prop(prop(jd, 'result'), 'content'))) if (er or prop(prop(jd, 'result'), 'isError')) else 'the seat answered ' + str(hs)) if prop(rq, 'status') == 'ok' else str(prop(rq, 'head') or 'the request failed')} if rq != None else None

Shell.tick on-setter membrama-loop-poll:
  WHEN this.open and prop('Nav:log', 'active') == True and prop('MLoop:main', 'on') == True and not prop('MLoop:main', 'polling') and not prop('Conn:page', 'hidden') and this.tick - (prop('MLoop:main', 'last_poll') or 0) >= this.status_ms / 1000:
    n = (prop('MLoop:main', 'seq') or 0) + 1
    ('MLoop:main').seq = n
    ('MLoop:main').polling = True
    ('Fetch:mloop:read').request = {'timeout_s': 10, 'id': 'mloop-read-' + str(n), 'url': '/mcp', 'method': 'POST', 'headers': {'content-type': 'application/json'}, 'body': str({'jsonrpc': '2.0', 'id': n, 'method': 'tools/call', 'params': {'name': 'entity_read', 'arguments': {'spec': '@NS@::Loop:main', 'prop': 'chat'}}})}

Fetch.ml on-setter membrama-loop-step:
  WHEN this.eid == 'Fetch:mloop:read' and this.ml != None and not prop(this.ml, 'ok'):
    ('MLoop:main').note = 'the seat did not answer the loop chat: ' + str(prop(this.ml, 'why'))
    ('MLoop:main').polling = False
    ('MLoop:main').last_poll = clock
  ELSE WHEN this.eid == 'Fetch:mloop:read' and this.ml != None:
    ('MLoop:main').text = str(prop(this.ml, 'text') or '')
    ('MLoop:main').note = None
    ('MLoop:main').polling = False
    ('MLoop:main').last_poll = clock

MLoop.shown getter: ('' if (' has no text' in str(this.text or '')) or startswith(str(this.text or ''), 'no such entity') else str(this.text or '')) or '(nothing yet: the loop has not been asked anything)'
MLoop.full getter: this.shown + (('\n' + str(this.note)) if this.note else '')
MLoop.full on-setter membrama-loop-show:
  WHEN this.on == True:
    ('DomNode:mloop:chat').text = this.full
MLoop.on on-setter membrama-loop-first:
  WHEN this.on == True:
    ('DomNode:mloop:chat').text = this.full
