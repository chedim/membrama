PACK membrama_logview 1
IMPORT dom 1
IMPORT fetch 1
IMPORT shell_view 1
-- THE LOG TAB (written to the seat by membrama when it connects, `Pack:membrama_logview.text`; the seat places it on the page because it imports `dom`). A tab in the shell (`Nav:membrama_log`, the view-pack
-- contract of docs/ui-rebuild-plan.md) that shows the LATEST lines of the seat's boundary log, one per change: `n eid.prop op by writer`, and follows new ones while the tab is the one in front.
-- The page cannot read the view by its link (`membrane::LogView:<ns>` is virtual and a link does not carry a virtual entity's values), so it does what docs/logview.md says a page does, with the door
-- (`POST /mcp`, as link_view.c1f does): it ASKS by writing `<its ns>::LogAsk:main` (`from`, then `n`, a count: the cache breaker) and READS `membrane::LogView:<its ns>` with `entity_read`.
--   on open       one ask (`n` only, from 0), read `head`; then ask from max(0, head - (200 - 1)), so the page shows the last 200 lines
--   on the tick   the shell's own (`Shell.tick`, at the shell's `status_ms`), only while the tab is active: ask from the line after the last one shown (a new `n`), read `rows`, append, keep the last 200
-- 200 is the seat's own page size (packs/logview.c1f). The three calls of an ask are `Fetch:mlog:from`, `Fetch:mlog:n`, `Fetch:mlog:read`, one POST each, chained by their receipts. A call that fails is `MLog:main.note`,
-- shown on the tab. The tab scrolls (`panelrows`) and stays at the bottom unless the person scrolled up (`near`, by the chat's own `stick_px`); "Load older lines" puts the 200 lines before the first one above it. The guard pack removes this tab when membrama's link is not up.
--   MLog:main   `first` (the number of the first line shown), `pages` (loads the person asked for: the cap of lines is 200 x pages), `more`, `near`, `holding`, `older_out`, `phase` (None, 'head', 'follow'), `step` (from, n, read, headread), `last` (the number of the last line shown), `lines`, `seq`, `polling`, `last_poll`, `note`

Shell.open on-setter membrama-log-register:
  WHEN this.open:
    ('Nav:membrama_log').title = 'Log'
    ('Nav:membrama_log').order = 85

Nav.active on-setter membrama-log-draw:
  WHEN this.eid == 'Nav:membrama_log' and this.active == True:
    ('DomNode:mlog:root').tag = 'div'
    ('DomNode:mlog:root').class = 'panelrows'
    ('DomNode:mlog:root').parent = 'DomNode:shell:slot:membrama_log'
    ('DomNode:mlog:older').parent = 'DomNode:mlog:root'
    ('DomNode:mlog:older').tag = 'div'
    ('DomNode:mlog:older').hidden = True
    ('DomNode:mlog:older:btn').parent = 'DomNode:mlog:older'
    ('DomNode:mlog:older:btn').tag = 'button'
    ('DomNode:mlog:older:btn').type = 'button'
    ('DomNode:mlog:older:btn').text = 'Load older lines'
    ('DomNode:mlog:text').parent = 'DomNode:mlog:root'
    ('DomNode:mlog:text').tag = 'pre'
    ('DomNode:mlog:chathead').parent = 'DomNode:mlog:root'
    ('DomNode:mlog:chathead').tag = 'div'
    ('DomNode:mlog:chathead').text = 'Chat with the model (raw: the prompt, the reply with its thinking, each call and its result; the oldest text drops first)'
    ('DomNode:mlog:chat').parent = 'DomNode:mlog:root'
    ('DomNode:mlog:chat').tag = 'pre'
    ('Nav:membrama_log').filled = True
    ('MLog:main').on = True

MLog.ns getter: prop('Link:page', 'ns')
MLog.text getter: join(this.lines or [], '\n') + (('\n' if this.lines else '') + str(this.note) if this.note else '')
-- the button shows while there are older lines than the first one shown
MLog.more getter: this.first != None and this.first > 0
MLog.more on-setter membrama-log-more:
  WHEN this.on == True:
    ('DomNode:mlog:older').hidden = not this.more
-- the lines are kept at the bottom after they are drawn, unless the person scrolled up (`near` false; no scroll seen yet counts as near) or older lines were just put above (`holding`)
MLog.text on-setter membrama-log-text:
  WHEN this.on == True and this.near != False and not this.holding:
    ('DomNode:mlog:text').text = this.text
    ('DomNode:mlog:root').scroll = 'end'
  ELSE WHEN this.on == True:
    ('DomNode:mlog:text').text = this.text
MLog.on on-setter membrama-log-first:
  WHEN this.on == True:
    ('DomNode:mlog:text').text = this.text
-- near the bottom within the chat's own `stick_px` (the owner's number); a pack write of `scroll` (the command 'end', no height) is not a measure; no chat view counts as near
DomNode.scroll on-setter membrama-log-scroll:
  WHEN this.eid == 'DomNode:mlog:root' and prop(this.scroll, 'height') != None:
    ('MLog:main').near = prop('View:chat', 'stick_px') == None or prop(this.scroll, 'height') - prop(this.scroll, 'top') - prop(this.scroll, 'client') < prop('View:chat', 'stick_px')
-- "Load older lines": the page before the first one shown (200 lines, the seat's page size); the same chain of calls, asked from max(0, first - 200)
DomNode.clicked on-setter membrama-log-older-click:
  WHEN this.eid == 'DomNode:mlog:older:btn' and not prop('MLog:main', 'polling') and prop('MLog:main', 'more') == True:
    n = (prop('MLog:main', 'seq') or 0) + 1
    ('MLog:main').seq = n
    ('MLog:main').polling = True
    ('MLog:main').older_out = True
    ('MLog:main').holding = True
    ('MLog:main').step = 'from'
    ('Fetch:mlog:from').request = {'timeout_s': 10, 'id': 'mlog-from-' + str(n), 'url': '/mcp', 'method': 'POST', 'headers': {'content-type': 'application/json'}, 'body': str({'jsonrpc': '2.0', 'id': n, 'method': 'tools/call', 'params': {'name': 'entity_write', 'arguments': {'spec': prop('MLog:main', 'ns') + '::LogAsk:main', 'prop': 'from', 'value': max(0, prop('MLog:main', 'first') - 200)}}})}

-- the receipt of a call, read once: ok = the seat answered 2xx and the call has no error; `text` is what the door's tool answered
Fetch.mq getter:
  rq = this.request_result
  bd = json(str(prop(rq, 'body') or ''))
  jd = bd if bd is Dict else {}
  hs = prop(rq, 'http_status')
  cs = prop(prop(jd, 'result'), 'content') or []
  er = prop(jd, 'error')
  {'ok': prop(rq, 'status') == 'ok' and hs != None and hs >= 200 and hs < 300 and not er and not prop(prop(jd, 'result'), 'isError'), 'text': prop(cs[0], 'text') if len(cs) > 0 else None, 'why': (str(prop(er, 'message') if er is Dict else (er or prop(prop(jd, 'result'), 'content'))) if (er or prop(prop(jd, 'result'), 'isError')) else 'the seat answered ' + str(hs)) if prop(rq, 'status') == 'ok' else str(prop(rq, 'head') or 'the request failed')} if rq != None else None

-- an ask starts on the shell's tick, while the tab is in front and none is running; the first one finds the head
Shell.tick on-setter membrama-log-poll:
  WHEN this.open and prop('Nav:membrama_log', 'active') == True and prop('MLog:main', 'ns') != None and not prop('MLog:main', 'polling') and not prop('Conn:page', 'hidden') and this.tick - (prop('MLog:main', 'last_poll') or 0) >= this.status_ms / 1000 and prop('MLog:main', 'phase') == None:
    n = (prop('MLog:main', 'seq') or 0) + 1
    ('MLog:main').seq = n
    ('MLog:main').polling = True
    ('MLog:main').phase = 'head'
    ('MLog:main').step = 'n'
    ('Fetch:mlog:n').request = {'timeout_s': 10, 'id': 'mlog-n-' + str(n), 'url': '/mcp', 'method': 'POST', 'headers': {'content-type': 'application/json'}, 'body': str({'jsonrpc': '2.0', 'id': n, 'method': 'tools/call', 'params': {'name': 'entity_write', 'arguments': {'spec': prop('MLog:main', 'ns') + '::LogAsk:main', 'prop': 'n', 'value': n}}})}
  ELSE WHEN this.open and prop('Nav:membrama_log', 'active') == True and prop('MLog:main', 'ns') != None and not prop('MLog:main', 'polling') and not prop('Conn:page', 'hidden') and this.tick - (prop('MLog:main', 'last_poll') or 0) >= this.status_ms / 1000 and prop('MLog:main', 'phase') == 'follow':
    n = (prop('MLog:main', 'seq') or 0) + 1
    ('MLog:main').seq = n
    ('MLog:main').polling = True
    ('MLog:main').step = 'from'
    ('Fetch:mlog:from').request = {'timeout_s': 10, 'id': 'mlog-from-' + str(n), 'url': '/mcp', 'method': 'POST', 'headers': {'content-type': 'application/json'}, 'body': str({'jsonrpc': '2.0', 'id': n, 'method': 'tools/call', 'params': {'name': 'entity_write', 'arguments': {'spec': prop('MLog:main', 'ns') + '::LogAsk:main', 'prop': 'from', 'value': prop('MLog:main', 'last') + 1}}})}

-- the calls of an ask, one after the other, by their receipts
Fetch.mq on-setter membrama-log-step:
  WHEN startswith(this.eid, 'Fetch:mlog:') and this.mq != None and not prop(this.mq, 'ok'):
    ('MLog:main').note = 'the seat did not answer the log tab (' + this.eid + '): ' + str(prop(this.mq, 'why'))
    ('MLog:main').polling = False
    ('MLog:main').last_poll = clock
  ELSE WHEN this.eid == 'Fetch:mlog:from' and this.mq != None and prop('MLog:main', 'step') == 'from':
    ('MLog:main').step = 'n'
    ('Fetch:mlog:n').request = {'timeout_s': 10, 'id': 'mlog-n-' + str(prop('MLog:main', 'seq')), 'url': '/mcp', 'method': 'POST', 'headers': {'content-type': 'application/json'}, 'body': str({'jsonrpc': '2.0', 'id': prop('MLog:main', 'seq'), 'method': 'tools/call', 'params': {'name': 'entity_write', 'arguments': {'spec': prop('MLog:main', 'ns') + '::LogAsk:main', 'prop': 'n', 'value': prop('MLog:main', 'seq')}}})}
  ELSE WHEN this.eid == 'Fetch:mlog:n' and this.mq != None and prop('MLog:main', 'step') == 'n':
    ('MLog:main').step = 'headread' if prop('MLog:main', 'phase') == 'head' else 'read'
    ('Fetch:mlog:read').request = {'timeout_s': 10, 'id': 'mlog-read-' + str(prop('MLog:main', 'seq')), 'url': '/mcp', 'method': 'POST', 'headers': {'content-type': 'application/json'}, 'body': str({'jsonrpc': '2.0', 'id': prop('MLog:main', 'seq'), 'method': 'tools/call', 'params': {'name': 'entity_read', 'arguments': {'spec': 'membrane::LogView:' + prop('MLog:main', 'ns'), 'prop': 'head' if prop('MLog:main', 'phase') == 'head' else 'rows'}}})}
  ELSE WHEN this.eid == 'Fetch:mlog:read' and this.mq != None and prop('MLog:main', 'step') == 'headread':
    hd = num(str(prop(this.mq, 'text') or ''))
    ('MLog:main').last = (max(0, hd - 199) - 1) if hd is Number else -1
    ('MLog:main').first = (max(0, hd - 199)) if hd is Number else 0
    ('MLog:main').phase = 'follow'
    ('MLog:main').note = None
    ('MLog:main').polling = False
    ('MLog:main').last_poll = 0
  ELSE WHEN this.eid == 'Fetch:mlog:read' and this.mq != None and prop('MLog:main', 'step') == 'read' and prop('MLog:main', 'older_out') == True:
    rs = json(str(prop(this.mq, 'text') or ''))
    ow = [r for r in (rs if rs is List else []) if prop(r, 'n') < prop('MLog:main', 'first')]
    ('MLog:main').older_out = False
    ('MLog:main').pages = (prop('MLog:main', 'pages') or 1) + 1
    ('MLog:main').first = min([prop(r, 'n') for r in ow]) if len(ow) > 0 else prop('MLog:main', 'first')
    ('MLog:main').lines = concat([str(prop(r, 'n')) + ' ' + str(prop(r, 'eid')) + '.' + str(prop(r, 'prop')) + ' ' + str(prop(r, 'op')) + ' by ' + str(prop(r, 'writer')) for r in ow], prop('MLog:main', 'lines') or [])
    ('MLog:main').note = None
    ('MLog:main').polling = False
    ('MLog:main').last_poll = clock
  ELSE WHEN this.eid == 'Fetch:mlog:read' and this.mq != None and prop('MLog:main', 'step') == 'read':
    rs = json(str(prop(this.mq, 'text') or ''))
    rw = [r for r in (rs if rs is List else []) if prop(r, 'n') > (prop('MLog:main', 'last') if prop('MLog:main', 'last') != None else -1)]
    ('MLog:main').holding = False
    nl = tail(concat(prop('MLog:main', 'lines') or [], [str(prop(r, 'n')) + ' ' + str(prop(r, 'eid')) + '.' + str(prop(r, 'prop')) + ' ' + str(prop(r, 'op')) + ' by ' + str(prop(r, 'writer')) for r in rw]), 200 * (prop('MLog:main', 'pages') or 1))
    ('MLog:main').last = max([prop(r, 'n') for r in rw]) if len(rw) > 0 else prop('MLog:main', 'last')
    ('MLog:main').first = (max([prop(r, 'n') for r in rw]) - len(nl) + 1) if len(rw) > 0 else prop('MLog:main', 'first')
    ('MLog:main').lines = nl
    ('MLog:main').note = None
    ('MLog:main').polling = False
    ('MLog:main').last_poll = clock

-- THE RAW CHAT WITH THE MODEL, under the log lines: the loop's own `@NS@::Loop:main.chat` (src/brain.rs, `chat_add`), read by the door like the log (`entity_read`, one POST, `Fetch:mchat:read`) on the same tick, while the tab is in front.
-- Its own state `MChat:main` (`text`, `polling`, `last_poll`, `seq`, `note`) so it never waits on the log's calls; a call that fails is said under the heading.
Shell.tick on-setter membrama-chat-poll:
  WHEN this.open and prop('Nav:membrama_log', 'active') == True and not prop('MChat:main', 'polling') and not prop('Conn:page', 'hidden') and this.tick - (prop('MChat:main', 'last_poll') or 0) >= this.status_ms / 1000:
    n = (prop('MChat:main', 'seq') or 0) + 1
    ('MChat:main').seq = n
    ('MChat:main').polling = True
    ('Fetch:mchat:read').request = {'timeout_s': 10, 'id': 'mchat-read-' + str(n), 'url': '/mcp', 'method': 'POST', 'headers': {'content-type': 'application/json'}, 'body': str({'jsonrpc': '2.0', 'id': n, 'method': 'tools/call', 'params': {'name': 'entity_read', 'arguments': {'spec': '@NS@::Loop:main', 'prop': 'chat'}}})}

Fetch.mq on-setter membrama-chat-step:
  WHEN this.eid == 'Fetch:mchat:read' and this.mq != None and not prop(this.mq, 'ok'):
    ('MChat:main').note = 'the seat did not answer the model chat: ' + str(prop(this.mq, 'why'))
    ('MChat:main').polling = False
    ('MChat:main').last_poll = clock
  ELSE WHEN this.eid == 'Fetch:mchat:read' and this.mq != None:
    ('MChat:main').text = str(prop(this.mq, 'text') or '')
    ('MChat:main').note = None
    ('MChat:main').polling = False
    ('MChat:main').last_poll = clock

MChat.shown getter: (str(this.text) if this.text else '(nothing yet: the model has not been asked anything)') + (('\n' + str(this.note)) if this.note else '')
MChat.shown on-setter membrama-chat-show:
  WHEN prop('Nav:membrama_log', 'filled') == True:
    ('DomNode:mlog:chat').text = this.shown
